configfile: "config.yaml"

import os
import json
import gzip
import itertools
from snakemake.remote.HTTP import RemoteProvider as HTTPRemoteProvider

HTTP = HTTPRemoteProvider()

wildcard_constraints:
    version="[\d.]+",
    gwas="[^-]+",
    name="[^-]+",
    population="[^-]+",
    method="[^-]+"

include: "rules/dependencies.smk"
include: "rules/target_qc.smk"
include: "rules/pgs_methods.smk"
#include: "rules/magma.smk"
include: "rules/target_scoring.smk"
include: "rules/report.smk"

# Every other barrier/aggregator rule (the *_all/*_i-less wrapper rules) has
# no shell/run/script directive, so Snakemake already runs them locally
# without a cluster submission - confirmed in job logs, which label them
# "localrule". ancestry_reporter and score_reporter are the only checkpoints
# that DO have a real shell command (an Rscript call) despite being cheap
# (well under a second of actual work each per --benchmark data), so they're
# the only rules that actually need this declaration to stop paying a full
# SLURM queue+dispatch round trip for near-instant work.
localrules: ancestry_reporter, score_reporter
